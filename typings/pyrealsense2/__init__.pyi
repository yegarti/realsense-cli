    def toggle_advanced_mode(self, enable: bool) -> None: ...
    def serialize_json(self) -> str: ...

# An advanced-mode group struct: its fields, by name, through the mapping interface
class _AdvancedModeGroup:
    def __init__(self) -> None: ...
    def keys(self) -> list[str]: ...
    def __getitem__(self, field: str) -> float: ...
    def __setitem__(self, field: str, value: float) -> None: ...

class STDepthControlGroup(_AdvancedModeGroup): ...
class STRsm(_AdvancedModeGroup): ...

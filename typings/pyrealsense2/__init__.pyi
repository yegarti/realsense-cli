# Partial stub for pyrealsense2, covering only the API realsense-cli uses.
# pyrealsense2 is a pybind11 module and ships no type information.
# Enum classes expose their members through `__members__`, like pybind11 enums do at runtime.

from collections.abc import Callable, Iterator
from datetime import timedelta
from typing import ClassVar, overload

__version__: str
__full_version__: str

class camera_info:
    __members__: ClassVar[dict[str, camera_info]]
    name: ClassVar[camera_info]
    serial_number: ClassVar[camera_info]
    firmware_version: ClassVar[camera_info]
    usb_type_descriptor: ClassVar[camera_info]
    product_line: ClassVar[camera_info]
    advanced_mode: ClassVar[camera_info]

class option:
    __members__: ClassVar[dict[str, option]]
    depth_units: ClassVar[option]
    visual_preset: ClassVar[option]
    @property
    def name(self) -> str: ...

class rs400_visual_preset:
    __members__: ClassVar[dict[str, rs400_visual_preset]]

class format:
    __members__: ClassVar[dict[str, format]]
    @property
    def name(self) -> str: ...

_Format = format

class stream:
    __members__: ClassVar[dict[str, stream]]
    depth: ClassVar[stream]
    infrared: ClassVar[stream]
    color: ClassVar[stream]
    gyro: ClassVar[stream]
    accel: ClassVar[stream]
    @property
    def name(self) -> str: ...

class frame_metadata_value:
    __members__: ClassVar[dict[str, frame_metadata_value]]
    @property
    def name(self) -> str: ...

class distortion:
    __members__: ClassVar[dict[str, distortion]]
    @property
    def name(self) -> str: ...

class intrinsics:
    width: int
    height: int
    ppx: float
    ppy: float
    fx: float
    fy: float
    model: distortion
    coeffs: list[float]
    def __init__(self) -> None: ...

class extrinsics:
    rotation: list[float]
    translation: list[float]
    def __init__(self) -> None: ...

class timestamp_domain:
    hardware_clock: ClassVar[timestamp_domain]

class option_range:
    min: float
    max: float
    step: float
    default: float
    def __init__(self) -> None: ...

class stream_profile:
    def stream_name(self) -> str: ...
    def stream_type(self) -> stream: ...
    def stream_index(self) -> int: ...
    def fps(self) -> int: ...
    def format(self) -> _Format: ...
    def is_default(self) -> bool: ...
    def is_video_stream_profile(self) -> bool: ...
    def is_motion_stream_profile(self) -> bool: ...
    def as_video_stream_profile(self) -> video_stream_profile: ...
    def as_motion_stream_profile(self) -> motion_stream_profile: ...
    def get_extrinsics_to(self, to: stream_profile) -> extrinsics: ...
    def register_extrinsics_to(self, to: stream_profile, extrinsics: extrinsics) -> None: ...

class video_stream_profile(stream_profile):
    def width(self) -> int: ...
    def height(self) -> int: ...
    def get_intrinsics(self) -> intrinsics: ...

class motion_stream_profile(stream_profile): ...

class frame:
    def get_profile(self) -> stream_profile: ...
    def get_timestamp(self) -> float: ...
    def get_frame_number(self) -> int: ...
    def supports_frame_metadata(self, frame_metadata: frame_metadata_value) -> bool: ...
    def get_frame_metadata(self, frame_metadata: frame_metadata_value) -> int: ...
    def is_frameset(self) -> bool: ...
    def as_frameset(self) -> composite_frame: ...
    def is_video_frame(self) -> bool: ...
    def as_video_frame(self) -> video_frame: ...
    def is_depth_frame(self) -> bool: ...
    def get_data(self) -> BufData: ...

class BufData:
    def __buffer__(self, flags: int, /) -> memoryview: ...

class video_frame(frame):
    def get_width(self) -> int: ...
    def get_height(self) -> int: ...
    def get_stride_in_bytes(self) -> int: ...
    def get_bytes_per_pixel(self) -> int: ...

class colorizer:
    def __init__(self) -> None: ...
    def colorize(self, depth: frame) -> video_frame: ...

class composite_frame(frame):
    def __iter__(self) -> Iterator[frame]: ...
    def __len__(self) -> int: ...

class frame_queue:
    def __init__(self, capacity: int = 1, keep_frames: bool = False) -> None: ...
    def try_wait_for_frame(self, timeout_ms: int = 5000) -> tuple[bool, frame]: ...

class sensor:
    @property
    def name(self) -> str: ...
    def get_info(self, info: camera_info) -> str: ...
    @overload
    def supports(self, arg0: camera_info) -> bool: ...
    @overload
    def supports(self, arg0: option) -> bool: ...
    def get_supported_options(self) -> list[option]: ...
    def is_option_read_only(self, option: option) -> bool: ...
    def get_option_description(self, option: option) -> str: ...
    def get_option_range(self, option: option) -> option_range: ...
    def get_option(self, option: option) -> float: ...
    def set_option(self, option: option, value: float) -> None: ...
    def get_stream_profiles(self) -> list[stream_profile]: ...
    def get_active_streams(self) -> list[stream_profile]: ...
    @overload
    def open(self, profile: stream_profile) -> None: ...
    @overload
    def open(self, profiles: list[stream_profile]) -> None: ...
    def start(self, queue: frame_queue | Callable[[frame], None]) -> None: ...
    def stop(self) -> None: ...
    def close(self) -> None: ...
    def is_depth_sensor(self) -> bool: ...
    def as_depth_sensor(self) -> depth_sensor: ...

class depth_sensor(sensor):
    def get_depth_scale(self) -> float: ...

